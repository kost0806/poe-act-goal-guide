<Window x:Class="PoeActGuide.App.OverlayWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PoE 액트 가이드"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        FontFamily="Malgun Gothic, Segoe UI"
        FontSize="{Binding FontSize}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </Window.Resources>

  <Border CornerRadius="6"
          Background="{Binding Background}"
          BorderBrush="{Binding BorderBrush}"
          BorderThickness="1"
          Padding="10,8,10,10">
    <StackPanel>

      <!-- Header: act, manual badge, current area -->
      <DockPanel LastChildFill="False">
        <TextBlock DockPanel.Dock="Left"
                   Text="{Binding Title}"
                   FontSize="{Binding TitleFontSize}"
                   FontWeight="Bold"
                   Foreground="#FFF2E6C9" />
        <Border DockPanel.Dock="Left"
                Margin="6,0,0,0"
                Padding="4,0"
                VerticalAlignment="Center"
                CornerRadius="3"
                Background="#FF6B4E16"
                Visibility="{Binding IsManual, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="수동 선택" FontSize="{Binding SmallFontSize}" Foreground="#FFFFE2A8" />
        </Border>
        <TextBlock DockPanel.Dock="Left"
                   Margin="8,0,0,0"
                   VerticalAlignment="Center"
                   Text="{Binding Progress}"
                   FontSize="{Binding SmallFontSize}"
                   Foreground="#FFB8B2A6" />
        <TextBlock DockPanel.Dock="Right"
                   VerticalAlignment="Center"
                   Text="{Binding Subtitle}"
                   FontSize="{Binding SmallFontSize}"
                   Foreground="#FFB8B2A6" />
      </DockPanel>

      <TextBlock Margin="0,4,0,0"
                 Text="{Binding Status}"
                 TextWrapping="Wrap"
                 FontSize="{Binding SmallFontSize}"
                 Foreground="#FFFFB15C"
                 Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />

      <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Steps}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{Binding RowBrush}" CornerRadius="3" Padding="3,2" Margin="0,1,0,1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Margin="0,1,6,0"
                        Padding="3,0"
                        MinWidth="40"
                        VerticalAlignment="Top"
                        CornerRadius="2"
                        BorderThickness="1"
                        BorderBrush="{Binding TagBrush}">
                  <TextBlock Text="{Binding Tag}"
                             HorizontalAlignment="Center"
                             Foreground="{Binding TagBrush}"
                             FontSize="{Binding DataContext.SmallFontSize, RelativeSource={RelativeSource AncestorType=Window}}" />
                </Border>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Text}"
                             TextWrapping="Wrap"
                             Foreground="{Binding TextBrush}"
                             FontWeight="{Binding Weight}" />
                  <TextBlock Text="{Binding Note}"
                             TextWrapping="Wrap"
                             Foreground="{Binding NoteBrush}"
                             FontSize="{Binding DataContext.SmallFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                             Visibility="{Binding ShowNote, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Margin="0,8,0,0"
                 Text="{Binding MoveModeHint}"
                 TextWrapping="Wrap"
                 FontSize="{Binding SmallFontSize}"
                 Foreground="#FFFFC35C"
                 Visibility="{Binding IsMoveMode, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>
  </Border>
</Window>
